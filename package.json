{
  "name": "openchat-desktop",
  "version": "0.1.0",
  "description": "A lightweight Chatbox-style ChatGPT desktop client",
  "main": "dist/src/main/bootstrap/main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:vite": "vite",
    "build": "tsc --noEmit && vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "test": "node --require ./scripts/polyfill-crypto.js ./node_modules/vitest/vitest.mjs run",
    "test:watch": "vitest",
    "start": "electron .",
    "package": "electron-builder",
    "package:win": "electron-builder --win",
    "package:win:nsis": "electron-builder --win nsis",
    "package:win:portable": "electron-builder --win portable",
    "package:win:zip": "electron-builder --win zip",
    "package:mac": "electron-builder --mac"
  },
  "dependencies": {
    "https-proxy-agent": "^5.0.1",
    "katex": "^0.18.4",
    "react-markdown": "^9.0.1",
    "rehype-katex": "^7.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-math": "^6.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "socks-proxy-agent": "^5.0.1",
    "sql.js": "1.10.3",
    "zustand": "4.5.7"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "18.19.39",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "@types/sql.js": "1.4.9",
    "@vitejs/plugin-react": "4.3.1",
    "electron": "22.3.27",
    "electron-builder": "24.13.3",
    "typescript": "5.4.5",
    "vite": "4.5.3",
    "vitest": "1.6.1"
  }
}
